<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.mutsuna_echo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- The WebView currently uses the light application theme even when
             the device is in dark mode. Keep system-bar contrast consistent. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
